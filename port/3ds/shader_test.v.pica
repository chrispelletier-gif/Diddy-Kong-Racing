; Pass-through vertex shader, only used by the GPU self test (gfx_c3d.c). Same as the SM64 3DS port's shader.

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.entry testmain
.proc testmain
	mov outpos, inpos
	mov outtc0, intex
	mov outtc1, intex
	mov outclr, inclr
	end
.end
